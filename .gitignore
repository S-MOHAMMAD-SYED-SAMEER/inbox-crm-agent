# Merged by local restructuring (Milestone 1, prepared not committed):
# previously this project relied on ai-business-automation's root
# .gitignore for the generic rules below. Now standalone, it needs its
# own copy of them. The project-specific rules beneath are unchanged
# from the monorepo version.

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
build/

# Env
.env
.env.local
.env.*.local

# Local SQLite databases (conversation memory, etc.)
*.sqlite
*.sqlite3
*.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# OS
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# --- Project-specific (unchanged from the monorepo) ---
# SQLite's WAL sidecar files, which exist only while the database is
# open — long enough for a `git add -A` during a running server to
# sweep a binary journal into a commit.
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal

# Generated evaluation output (the dataset itself stays committed).
server/eval-results/
