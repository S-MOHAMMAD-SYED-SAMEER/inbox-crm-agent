# Copy to `.env` and fill in only what you need. Every value below has a
# working default: with no .env file at all, the whole foundation migrates,
# seeds, tests, and runs — with no API key and no database server.
#
# `.env` is gitignored repo-wide. This file is committed and must never contain
# a real value.

# --- Database ---------------------------------------------------------------

# PostgreSQL connection string (D1). Leave EMPTY for local development: with no
# URL the server uses a local SQLite file, which needs no server, no Docker, and
# no account. Setting a postgres:// URL is the only change needed to run against
# a hosted database such as Neon.
DATABASE_URL=

# Where the local SQLite database lives. Optional — defaults to
# inbox-crm-agent/server/data/inbox-crm.sqlite. Use ":memory:" for a throwaway
# database (the tests already do this automatically).
SQLITE_PATH=

# --- AI provider ------------------------------------------------------------

# Which LLM provider to use: "mock", "anthropic", or "gemini".
#
# "mock" is the default and the only one implemented in M0 (D3). It replays
# registered fixtures deterministically, costs nothing, and needs no key — which
# is what lets the entire demo run offline and identically on every run.
# Asking for a provider that is not built yet fails loudly rather than quietly
# falling back to the mock: a run that believes it called Claude but actually
# replayed a fixture would invalidate any result taken from it.
LLM_PROVIDER=mock

# Claude API key (Anthropic Console). Required only when LLM_PROVIDER=anthropic.
# API spend is real money — do not switch providers without deciding to.
ANTHROPIC_API_KEY=

# The model used for classification, extraction, and drafting. Haiku 4.5 is the
# cost-driven choice fixed by CLAUDE.md; do not raise the tier without approval.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Gemini API key (Google AI Studio). Required only when LLM_PROVIDER=gemini.
GEMINI_API_KEY=

# --- Adapters ---------------------------------------------------------------

# Email source: "demo" (JSON fixtures) or "gmail" (not implemented).
EMAIL_SOURCE=demo

# CRM target: "local" (this database) or "hubspot" (not implemented).
CRM_TARGET=local

# --- Authentication (M5-A) --------------------------------------------------
#
# REQUIRED. Without it nobody can sign in and every API endpoint answers 401 —
# which is the correct behaviour for a machine nobody has configured, and the
# reason there is no built-in default password.
#
# Generate one:
#
#   npm run hash-password
#
# The password is read from stdin, never from an argument, so it does not land
# in shell history or the process list. Only the hash goes in this file; the
# password itself is never written anywhere by the tooling.
OPERATOR_PASSWORD_HASH=

# How long a session lasts. Fixed at sign-in — activity does not extend it.
SESSION_TTL_HOURS=12

# Whether session cookies carry `Secure`. Default true.
#
# Browsers refuse Secure cookies over plain HTTP, so local development over
# http://localhost needs this set to false. It is a deliberate opt-out that is
# reported at every boot, rather than a default that would silently ship
# insecure cookies to production.
# COOKIE_SECURE=false

# --- Outbound email ---------------------------------------------------------
#
# TWO LOCKS, AND BOTH MUST BE TURNED. Either one left at its default means
# nothing can be delivered: an approved reply stops in the outbox as
# `suppressed` and no provider is ever contacted.
#
# Neither is readable or writable from a browser. No request body, header or
# query string is consulted anywhere in the send path — these come from the
# process environment and nowhere else.
#
# Turning these on does NOT weaken anything else. A human still has to approve
# every reply, the approval is still bound to the exact plan they read, and the
# draft still has to pass every content check.

# Lock 1: whether the system may deliver mail at all.
ALLOW_OUTBOUND_SEND=false

# Lock 2: which provider delivers it.
#   none   (default) — nothing can be sent
#   mock            — a local, deterministic provider. No network, no credentials.
#   gmail           — declared for the future; not implemented, falls back to disabled.
OUTBOUND_PROVIDER=none

# What the mock provider does, so failure handling can be demonstrated without
# a real provider: success | temporary_failure | permanent_failure |
# unavailable | timeout
OUTBOUND_MOCK_BEHAVIOUR=success

# --- Behaviour --------------------------------------------------------------

# How much the system may do without asking: "manual", "assisted", or
# "autonomous_low_risk". Defaults to manual — a new client's trust is earned
# with evidence from their own inbox.
#
# NOTE: no level, and no value of any variable in this file, allows a
# consequential (tier-2) action — sending email, creating or changing a deal —
# to execute without a human. That is enforced in code, not configuration.
AUTONOMY_LEVEL=manual

# Hours before an unanswered approval expires. On expiry the email moves to
# needs_review — a timeout never resolves in the direction of acting.
APPROVAL_SLA_HOURS=24

# --- Server -----------------------------------------------------------------

# Port the API listens on. 3100 rather than 3000, so this can run at the same
# time as Project 1's demo during a client call.
PORT=3100

# One of: debug, info, warn, error.
LOG_LEVEL=info
