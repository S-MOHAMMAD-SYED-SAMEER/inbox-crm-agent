{
  "version": "understand-1.0.0",
  "note": [
    "M1 evaluation cases. Scoped to UNDERSTAND only — the full harness (§20) is M6.",
    "",
    "These expectations are written against the SPECIFICATION (§22), not copied from the canned",
    "model responses. That distinction is what makes the suite meaningful: several cases assert an",
    "outcome that differs from what the model said, so passing requires the deterministic layers to",
    "have actually done their job.",
    "",
    "The two that matter most:",
    "  E-02 — the model claims a budget of $5,000. The email states no budget. The expectation is",
    "         not_provided plus a recorded drop, so this case fails if provenance validation stops",
    "         working.",
    "  E-10 — the model is fooled and reports a clean sales inquiry with no injection flag. The",
    "         expectation is needs_review with possible_injection, so this case fails if the",
    "         deterministic detector ever stops being authoritative over the model's opinion."
  ],
  "cases": [
    {
      "id": "E-01",
      "providerMessageId": "demo-e01",
      "description": "Strong lead: Shopify store asking about an AI chatbot and its cost.",
      "expected": {
        "category": "sales_inquiry",
        "priority": "high",
        "confidenceBand": "high",
        "state": "resolving",
        "reviewReason": null,
        "mustExtract": {
          "contactName": "Sarah Williams",
          "contactEmail": "sarah@acmecommerce.io",
          "companyDomain": "acmecommerce.io"
        },
        "mustBePresent": ["companyName", "serviceInterest", "requirementSummary"],
        "mustBeNotProvided": ["budget", "timeline", "contactPhone", "jobTitle"],
        "questionAsked": true,
        "injectionSuspected": false,
        "droppedFields": []
      }
    },
    {
      "id": "E-02",
      "providerMessageId": "demo-e02",
      "description": "Service inquiry with NO budget stated. The model invents one; it must be discarded.",
      "expected": {
        "category": "service_inquiry",
        "priority": "medium",
        "confidenceBand": "high",
        "state": "resolving",
        "reviewReason": null,
        "mustExtract": {
          "contactName": "Tom Reyes",
          "companyName": "Northline Studio",
          "companyDomain": "northlinestudio.com"
        },
        "mustBePresent": ["requirementSummary", "serviceInterest"],
        "mustBeNotProvided": ["budget", "timeline"],
        "questionAsked": true,
        "injectionSuspected": false,
        "droppedFields": ["budget"]
      }
    },
    {
      "id": "E-03",
      "providerMessageId": "demo-e03",
